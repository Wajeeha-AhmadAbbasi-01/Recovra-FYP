# Application
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
SESSION_SECRET=change-me-use-long-random-string
SESSION_COOKIE_NAME=recovra_session
SESSION_MAX_AGE_SECONDS=604800

# Database
DATABASE_URL=postgresql+psycopg://recovra:recovra_dev@localhost:5432/recovra_dev
TEST_DATABASE_URL=postgresql+psycopg://recovra:recovra_dev@localhost:5432/recovra_test

# SMTP (development: Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_FROM_NAME=Recovra
SMTP_FROM_EMAIL=noreply@recovra.test

# Upload limits
PDF_MAX_FILES=10
PDF_MAX_BYTES=10485760
PDF_MAX_PAGES=10
UPLOAD_STORAGE_DIR=./data/uploads

# Invitations
INVITATION_EXPIRY_HOURS=72